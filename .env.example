# Neon PostgreSQL bağlantı dizesi. Sunucu tarafında kullanılır (NEXT_PUBLIC_
# öneki YOKTUR, istemci bundle'ına dahil edilmez). Gerçek değeri buraya
# yazmayın — bu dosya yalnızca örnektir ve versiyon kontrolüne dahildir.
# Kendi değerinizi, commit edilmeyen .env.local dosyasına yazın.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Site geneli geçici geliştirme şifre kapısı (proxy.ts + app/site-erisim/).
# Yalnızca NODE_ENV=production'da (Vercel preview/production, ya da yerel
# `npm run build && npm start`) etkindir; `npm run dev` bu değişkenden
# bağımsız olarak korumasızdır. Tanımsız/boş bırakılırsa production'da site
# tamamen kilitli kalır (fail-closed) — gerçek değeri yalnızca Vercel
# Environment Variables'a veya commit edilmeyen .env.local'a yazın.
MALSEVK_SITE_PASSWORD=change-me

# Supabase Auth (app/_lib/supabase/env.ts). İkisi de istemci bundle'ına dahil
# edilmesi GEREKEN, gizli olmayan public değerlerdir (proje URL'si + anon/
# publishable anahtar) — service_role/secret anahtar BURAYA veya .env.local'a
# ASLA yazılmaz (bkz. o dosyanın kendi dokümantasyonu). Gerçek development
# projesi değerlerini yalnızca commit edilmeyen .env.local'a yazın; Supabase
# Dashboard > Project Settings > API Keys'ten alınır.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# DÜZELTME (canlıya hazırlık, "Kritik Senkronizasyon Ayarı" görevi): bu
# değişken eskiden ilan/teklif/operasyon senkronunun (ilan oluşturma, farklı
# cihazdan ilan/teklif okuma, teklif kabul/ret/geri çekme/işe başlama/
# tamamlama/itiraz/anlaşma sağlanamadı) TEK açma/kapama anahtarıydı, varsayılanı
# da (bu dosyada) "false"tu — bu, buradaki varsayılanla yapılan bir prod
# deploy'un TÜM bu davranışı SESSİZCE (hiçbir hata/uyarı vermeden) devre dışı
# bırakması anlamına geliyordu. `app/_lib/supabase-job-sync.ts#isSupabaseJobSyncEnabled`
# artık bu değişkenden BAĞIMSIZ olarak her zaman etkin — söz konusu senkron
# artık koşulsuz/zorunlu. Bu değişken hâlâ okunuyor ama davranışı ARTIK
# BELİRLEMİYOR; yalnızca geçmişe dönük belge/uyumluluk amacıyla burada
# bırakıldı — yeni bir kurulumda tanımlanması GEREKMEZ.
NEXT_PUBLIC_ENABLE_SUPABASE_JOB_SYNC=true

# Resend (app/api/offer-notifications/route.ts) — "Yeni Teklif Geldi"/
# "Teklifiniz Kabul Edildi" e-postaları için. YALNIZCA sunucu tarafında
# (Route Handler, Node runtime) okunur — NEXT_PUBLIC_ öneki YOKTUR, istemci
# bundle'ına asla dahil edilmez. Gerçek anahtarı Resend Dashboard'dan alın
# (Resend hesabı ve malsevk.com domain doğrulaması gerekir) ve yalnızca
# commit edilmeyen .env.local'a yazın — bu değişken tanımsızsa route, gerçek
# bir e-posta göndermeyi hiç denemez, delivery kaydını "failed" olarak
# işaretler ve teklif/kabul işleminin kendisini asla bozmaz.
RESEND_API_KEY=re_your_resend_api_key

# Gönderen adresi — Resend'de doğrulanmış malsevk.com domaini üzerinden.
EMAIL_FROM=MALSEVK <noreply@malsevk.com>

# E-posta içindeki "Teklifi Görüntüle"/"Operasyonu Görüntüle" bağlantılarının
# taban URL'si. Development'ta http://localhost:3000 (varsayılan, bu
# değişken tanımsızsa da kullanılır); gerçek bir dağıtım ortamında o ortamın
# kendi URL'sine ayarlanmalıdır — canlı URL kod içine ASLA sabitlenmez.
APP_BASE_URL=http://localhost:3000

# Development giriş ekranındaki "Demo Hesaplar" paneli (demo-accounts-panel.tsx)
# için ortak demo şifresi. Yalnızca Development'ta anlamlıdır — panelin
# kendisi hem `NODE_ENV === "development"` (derleme zamanı, production
# build'inde panel/bu değer bundle'a hiç girmez) HEM `window.location.hostname`
# localhost/127.0.0.1 (çalışma zamanı) ikisi birden doğrulanmadan render
# edilmez. Gerçek değeri yalnızca commit edilmeyen .env.local'a yazın —
# Production ortamında bu değişken TANIMLI OLMAMALIDIR.
NEXT_PUBLIC_DEMO_ACCOUNT_PASSWORD=change-me
