# Neon PostgreSQL bağlantı dizesi. Sunucu tarafında kullanılır (NEXT_PUBLIC_
# öneki YOKTUR, istemci bundle'ına dahil edilmez). Gerçek değeri buraya
# yazmayın — bu dosya yalnızca örnektir ve versiyon kontrolüne dahildir.
# Kendi değerinizi, commit edilmeyen .env.local dosyasına yazın.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Site geneli geçici geliştirme şifre kapısı (proxy.ts + app/site-erisim/).
# Yalnızca NODE_ENV=production'da (Vercel preview/production, ya da yerel
# `npm run build && npm start`) etkindir; `npm run dev` bu değişkenden
# bağımsız olarak korumasızdır. Tanımsız/boş bırakılırsa production'da site
# tamamen kilitli kalır (fail-closed) — gerçek değeri yalnızca Vercel
# Environment Variables'a veya commit edilmeyen .env.local'a yazın.
MALSEVK_SITE_PASSWORD=change-me
